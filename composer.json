{
  "name": "rafrsr/generic-api",
  "description": "API Abstraction layer with mocks",
  "license": "MIT",
  "type": "library",
  "homepage": "http://rafrsr.github.io/generic-api/",
  "authors": [
    {
      "name": "Rafael SR",
      "email": "raf.rsr@gmail.com",
      "homepage": "https://github.com/rafrsr"
    }
  ],
  "support": {
    "wiki": "https://github.com/rafrsr/generic-api/wiki"
  },
  "keywords": [
    "api",
    "sdk",
    "guzzle"
  ],
  "autoload": {
    "files": [
      "autoload.php"
    ],
    "psr-4": {
      "Rafrsr\\GenericApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rafrsr\\GenericApi\\Tests\\": "tests/",
      "Rafrsr\\SampleApi\\": "sample/"
    }
  },
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.10",
    "symfony/validator": "^7.0|^8.0",
    "symfony/event-dispatcher": "^7.0|^8.0",
    "symfony/cache": "^7.0|^8.0",
    "symfony/property-access": "^7.0|^8.0",
    "jms/serializer": "^3.32",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0",
    "php-coveralls/php-coveralls": "^2.9"
  },
  "extra": {
    "branch-alias": {
      "v2": "2.0.x-dev",
      "dev-master": "3.0.x-dev"
    }
  }
}